# ==========================================
# NihongoHub 環境変数テンプレ
# すべて Vercel Dashboard → Settings → Environment Variables に設定
# ==========================================

# --- 必須 ---
# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# --- 推奨（未設定だとキャッシュ無効化 = コスト爆発リスク） ---
# Supabase (https://supabase.com/ → Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

# --- 推奨（未設定だとゲスト日次リミット無効化） ---
# Upstash Redis (https://console.upstash.com/ → Create Database → REST API タブ)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# --- 必須（/api/generate-batch 保護用） ---
# 任意の長いランダム文字列（生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
ADMIN_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe（決済有効化に必須）---
# Stripe Dashboard → Developers → API keys → Restricted or Secret key (sk_live_...)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# Stripe Dashboard → Products → 作成後 → Price ID (price_xxxxxxxxxxxx)
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_LIFETIME=price_xxxxxxxxxxxx
# Stripe Dashboard → Developers → Webhooks → エンドポイント作成後 → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Supabase anon key（auth.js が使用）---
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx

# --- 本番でのみ必須（CORS 制限） ---
# カンマ区切りで複数 origin 許可可。本番デプロイ前に必ず明示設定（未設定だと * で全許可になり API 濫用リスク）
# 例: https://www.nihongo-hub.com,https://nihongo-hub.com
ALLOWED_ORIGIN=https://www.nihongo-hub.com,https://nihongo-hub.com

# ==========================================
# 以下 2026-07-24 追記
# コードから参照されているのにこのテンプレートに載っていなかった 9 件。
# 未設定でも動くが、設定しないと機能が黙って縮退するものが含まれる。
# ==========================================

# --- 監視（未設定だと Sentry 通知が丸ごと無効化され、障害に気付けない）---
# lib/sentry.js
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# --- Stripe のリダイレクト先（未設定だと req.headers.host にフォールバックする）---
# api/stripe-portal.js / api/upgrade-checkout.js の success_url / cancel_url に使う。
# Host ヘッダ由来の値でリダイレクト先が決まる状態は避けたいので、本番では明示設定すること。
SITE_URL=https://www.nihongo-hub.com

# --- Pay-it-forward ギフトのメール送信（未設定だとコードは発行されるがメールが届かない）---
# api/stripe-webhook.js
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=NihongoHub <gifts@mail.nihongo-hub.com>

# --- ギフト購入リンク（未設定の間はトップページで自動非表示）---
# api/public-config.js
STRIPE_GIFT_X10_LINK=https://buy.stripe.com/xxxxxxxxxxxx

# --- Upstash の別名（Vercel KV 連携時に自動注入される）---
# 注意: api/count.js と lib/funnel-server.js はこの別名にフォールバックするが、
# lib/ratelimit.js と api/daily-coach.js は UPSTASH_* しか見ない。
# KV_* だけを設定するとレート制限が fail-open で無効化される。
# 両方設定するか、UPSTASH_* に統一すること。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel が自動注入（手動設定不要。lib/sentry.js が environment と release に使う）---
# VERCEL_ENV
# VERCEL_GIT_COMMIT_SHA
