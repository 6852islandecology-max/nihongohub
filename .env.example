# ==========================================
# NihongoHub 環境変数テンプレ
# すべて Vercel Dashboard → Settings → Environment Variables に設定
# ==========================================

# --- 必須 ---
# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# --- 推奨（未設定だとキャッシュ無効化 = コスト爆発リスク） ---
# Supabase (https://supabase.com/ → Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

# --- 推奨（未設定だとゲスト日次リミット無効化） ---
# Upstash Redis (https://console.upstash.com/ → Create Database → REST API タブ)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# --- 必須（/api/generate-batch 保護用） ---
# 任意の長いランダム文字列（生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
ADMIN_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 本番でのみ必須（CORS 制限） ---
# カンマ区切りで複数 origin 許可可。本番デプロイ前に必ず明示設定（未設定だと * で全許可になり API 濫用リスク）
# 例: https://www.nihongo-hub.com,https://nihongo-hub.com
ALLOWED_ORIGIN=https://www.nihongo-hub.com,https://nihongo-hub.com
